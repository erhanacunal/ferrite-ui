{
    "name": "ferrite-lang",
    "displayName": "Ferrite Language Support",
    "description": "Language support for ferrite-lang (.fl) — syntax highlighting, diagnostics, completions, and more.",
    "version": "1.0.1",
    "publisher": "ferrite-ui",
    "license": "MIT",
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:ferrite"
    ],
    "main": "./extension.js",
    "scripts": {
        "package": "npx --yes @vscode/vsce package --allow-missing-repository --skip-license"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "contributes": {
        "languages": [
            {
                "id": "ferrite",
                "aliases": [
                    "Ferrite",
                    "ferrite"
                ],
                "extensions": [
                    ".fl"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "ferrite",
                "scopeName": "source.ferrite",
                "path": "./syntaxes/ferrite.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "ferrite",
                "path": "./snippets/ferrite.json"
            }
        ],
        "configuration": {
            "title": "Ferrite Language",
            "properties": {
                "ferrite.server.python": {
                    "type": "string",
                    "default": "python",
                    "description": "Python interpreter to run the LSP server."
                },
                "ferrite.server.path": {
                    "type": "string",
                    "default": "",
                    "description": "Path to ferrite_lsp.py. If empty: <workspace>/tools/ferrite_lsp.py, then $FERRITE_UI/tools/ferrite_lsp.py, then next to the extension (when run from the repo)."
                },
                "ferrite.server.includeDirs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Extra include directories, added after the ones from the nearest project.json (or the file's dir + ferrite-ui lib/). Restart the server after changing."
                }
            }
        },
        "commands": [
            {
                "command": "ferrite.restartServer",
                "title": "Ferrite: Restart Language Server"
            }
        ]
    }
}
