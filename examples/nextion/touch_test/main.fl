#include "core.fl"
#include "color.fl"

var panel;
var btn1;
var btn2;

fn setup() {
    panel = alloc();
    target(panel);
    set(location, 150, 100);
    set(size, 500, 280);
    set(bg_color, BLUE);
    set(border, 3, 3, 3, 3);
    set(border_color, WHITE);
    parent(0);

    btn1 = alloc();
    target(btn1);
    set(location, 20, 20);
    set(size, 100, 60);
    set(bg_color, RED);
    set(press_color, rgb565(0, 0, 255));
    set(clickable, ON);
    parent(panel);

    btn2 = alloc();
    target(btn2);
    set(location, 40, 40);
    set(size, 100, 60);
    set(bg_color, rgb565(0, 255, 0));
    set(press_color, rgb565(0, 0, 255));
    set(clickable, ON);
    parent(panel);

    render();
    return 0;
}

fn loop() {
    // Main loop — touch events handled by callbacks
}

fn rgb565(r, g, b) {
    return (r & 0xF8) * 256 + (g & 0xFC) * 8 + b / 8;
}
