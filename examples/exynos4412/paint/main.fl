// main.fl — on_paint widgets on the exynos4412 (GPU compositor / capture test)
//
// Three panels draw themselves in on_paint with the VM's drawing builtins:
//   - bars:  a bar chart whose values change twice a second;
//   - star:  24 rotating lines, redrawn every frame while "Animate" is on;
//   - board: a static drawing, painted once, with a translucent card sliding over it
//            (every frame repaints what the card uncovers).
// The board captures each panel's drawing and draws it with the panel (the GPU
// compositor samples it), so the panels survive restores. The line at the bottom shows
// passes/s and frames/s; `ferrite_cli.py perf` or /api/status give the details.

#include "core.fl"
#include "color.fl"
#include "anim.fl"
#include "sysinfo.fl"

const BARS = 16;

var title_lbl;
var bars;
var star;
var board;
var card;
var card_lbl;
var anim_btn;
var anim_lbl;
var info_lbl;
var vals[16];
var seed = 12345;
var phase = 0;
var anim_on = 1;
var since = 0;
var bars_at = 0;
var passes0 = 0;
var frames0 = 0;

fn rgb565(r, g, b) {
    return (r & 0xF8) * 256 + (g & 0xFC) * 8 + b / 8;
}

fn next_rand() {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return seed / 65536;
}

fn panel(x, y, w, h, bg) {
    set(location, x, y);
    set(size, w, h);
    set(bg_color, bg);
    set(border, 2, 2, 2, 2);
    set(border_color, rgb565(70, 80, 120));
    parent(0);
    return 0;
}

// The bar chart: absolute coordinates inside the panel at (40, 90), 560 x 320.
fn paint_bars(wid) {
    var i = 0;
    while (i < BARS) {
        var h = vals[i];
        var x = 60 + i * 33;
        fillRect(x, 380 - h, 24, h, rgb565(80 + i * 10, 160, 240 - i * 8));
        rect(x, 380 - h, 24, h, WHITE);
        i++;
    }
    line(52, 382, 588, 382, rgb565(200, 200, 220));
    drawText(60, 120, 0, WHITE, 0, "bars (on_paint)");
}

// 24 lines around the centre of the panel at (660, 90), 580 x 320.
fn paint_star(wid) {
    var cx = 950;
    var cy = 250;
    var i = 0;
    while (i < 24) {
        var a = itof(phase + i * 15) * 3.14159 / 180.0;
        var len = 60 + (i % 4) * 30;
        var x = cx + ftoi(sin(a) * itof(len));
        var y = cy - ftoi(cos(a) * itof(len));
        line(cx, cy, x, y, rgb565(255, 120 + (i % 4) * 40, 60 + i * 8));
        fillCircle(x, y, 5, rgb565(255, 220, 120));
        i++;
    }
    circle(cx, cy, 150, rgb565(120, 130, 180));
    drawText(680, 120, 0, WHITE, 0, "star (on_paint, every frame)");
}

// A static drawing over the whole panel at (40, 440), 1200 x 260.
fn paint_board(wid) {
    var i = 0;
    while (i < 12) {
        var x = 80 + i * 96;
        fillCircle(x, 560, 34, rgb565(60 + i * 16, 90, 200 - i * 10));
        circle(x, 560, 40, WHITE);
        fillRect(x - 30, 620, 60, 40, rgb565(200 - i * 12, 140, 60 + i * 12));
        i++;
    }
    var y = 470;
    while (y < 690) {
        line(50, y, 1230, y, rgb565(50, 56, 80));
        y += 20;
    }
    drawText(60, 480, 0, WHITE, 0, "board (on_paint once, a card slides over it)");
}

fn set_anim() {
    if (anim_on) {
        animate(card, PROP_LOC_X, 900, 2500, EASE_IN_OUT | REPEAT_YOYO);
        target(anim_lbl);
        set(text, "Animate: on");
    } else {
        stopAnim(card);
        target(anim_lbl);
        set(text, "Animate: off");
    }
    dirty();
    return 0;
}

fn setup() {
    target(0);
    set(bg_color, rgb565(12, 12, 18));

    title_lbl = alloc();
    target(title_lbl);
    set(kind, KIND_LABEL);
    set(location, 0, 30);
    set(size, 1280, 40);
    set(text, "on_paint widgets: captured, drawn with their widget");
    set(text_color, WHITE);
    set(text_align, ALIGN_CENTER);
    set(font_id, 0);
    parent(0);

    var i = 0;
    while (i < BARS) {
        vals[i] = 40 + next_rand() % 220;
        i++;
    }

    bars = alloc();
    target(bars);
    panel(40, 90, 560, 320, rgb565(20, 24, 40));
    set(on_paint, @paint_bars);

    star = alloc();
    target(star);
    panel(660, 90, 580, 320, rgb565(28, 20, 34));
    set(on_paint, @paint_star);

    board = alloc();
    target(board);
    panel(40, 440, 1200, 260, rgb565(18, 30, 26));
    set(on_paint, @paint_board);

    card = alloc();
    target(card);
    set(location, 80, 500);
    set(size, 260, 140);
    set(bg_color, rgb565(240, 200, 120));
    set(alpha, 150);
    set(border_radius, 18);
    parent(0);

    card_lbl = alloc();
    target(card_lbl);
    set(kind, KIND_LABEL);
    set(location, 0, 0);
    set(size, 260, 140);
    set(text, "translucent card");
    set(text_color, BLACK);
    set(text_align, ALIGN_CENTER);
    set(font_id, 0);
    parent(card);

    anim_btn = alloc();
    target(anim_btn);
    set(kind, KIND_BUTTON);
    set(location, 40, 726);
    set(size, 240, 56);
    set(bg_color, rgb565(60, 80, 140));
    set(press_color, rgb565(100, 130, 210));
    set(border_radius, 12);
    set(clickable, ON);
    set(on_click, @on_anim);
    parent(0);

    anim_lbl = alloc();
    target(anim_lbl);
    set(kind, KIND_LABEL);
    set(location, 0, 0);
    set(size, 240, 56);
    set(text_color, WHITE);
    set(text_align, ALIGN_CENTER);
    set(font_id, 0);
    parent(anim_btn);

    info_lbl = alloc();
    target(info_lbl);
    set(kind, KIND_LABEL);
    set(location, 320, 726);
    set(size, 920, 56);
    set(text_color, rgb565(160, 170, 200));
    set(font_id, 0);
    parent(0);

    set_anim();
    since = millis();
    bars_at = since;
    passes0 = sysPasses();
    frames0 = sysFrames();
    return 0;
}

fn on_anim(wid) {
    anim_on = 1 - anim_on;
    set_anim();
}

fn loop() {
    var now = millis();
    if (anim_on) {
        phase = (phase + 2) % 360;
        target(star);
        dirty();
    }
    if (now - bars_at >= 500) {
        var i = 0;
        while (i < BARS) {
            vals[i] = 40 + next_rand() % 220;
            i++;
        }
        target(bars);
        dirty();
        bars_at = now;
    }
    if (now - since >= 2000) {
        var p = sysPasses();
        var f = sysFrames();
        strClear();
        target(info_lbl);
        set(text, concat(concat(concat(str("passes/s "), itos((p - passes0) * 1000 / (now - since))),
                                str("   frames/s ")), itos((f - frames0) * 1000 / (now - since))));
        dirty();
        since = now;
        passes0 = p;
        frames0 = f;
    }
}
