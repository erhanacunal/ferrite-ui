// main.fl — benchmark for the Exynos 4412 tablet (1280x800)
//
// Four modes; tap "Next" to switch. Each shows its own rate once a second.
// Run `ferrite_cli.py -p COMx perf --count 0` alongside for the main-loop
// profile (time per phase, VM instructions/s) of the firmware.
//
//   0 VM       — integer arithmetic loop, no drawing (interpreter speed)
//   1 Widgets  — 192 boxes recoloured every pass (dirty render throughput)
//   2 Fill     — full-screen fillRect every pass (raw fill bandwidth)
//   3 Idle     — empty loop (per-pass overhead: input, USART, present)

#include "core.fl"
#include "color.fl"

const SCREEN_W = 1280;
const SCREEN_H = 800;
const TOP = 120;            // header height; the test area is below it
const COLS = 16;
const ROWS = 12;
const BOX_W = 80;
const BOX_H = 56;
const VM_CHUNK = 20000;     // loop iterations per pass in mode 0

var mode = 0;
var title_lbl;
var rate_lbl;
var next_btn;
var next_lbl;
var grid;
var boxes[192];

var count = 0;              // work units this second
var since = 0;              // start of the current second (millis)
var phase = 0;              // colour phase for modes 1 and 2

fn mode_name() -> string {
    if (mode == 0) { return "VM arithmetic"; }
    if (mode == 1) { return "Widgets (192 boxes)"; }
    if (mode == 2) { return "Full-screen fillRect"; }
    return "Idle loop";
}

fn show_mode() {
    target(title_lbl);
    set(text, sprintf("Mode %d: %s", mode, mode_name()));
    target(rate_lbl);
    set(text, "measuring...");
    strClear();
    target(grid);
    set(visible, mode == 1);
    // Fill mode paints over the widget tree: clear it when leaving.
    target(0);
    dirty();
    count = 0;
    since = millis();
}

fn on_next(wid) {
    mode = (mode + 1) % 4;
    show_mode();
}

fn setup() {
    title_lbl = alloc();
    target(title_lbl);
    set(kind, KIND_LABEL);
    set(location, 24, 20);
    set(size, 900, 40);
    set(text_color, WHITE);
    parent(0);

    rate_lbl = alloc();
    target(rate_lbl);
    set(kind, KIND_LABEL);
    set(location, 24, 64);
    set(size, 900, 40);
    set(text_color, GREEN);
    parent(0);

    next_btn = alloc();
    target(next_btn);
    set(kind, KIND_BUTTON);
    set(location, SCREEN_W - 224, 20);
    set(size, 200, 80);
    set(bg_color, 0x2945);
    set(press_color, 0x52AA);
    set(border_radius, 12);
    set(clickable, 1);
    set(on_click, @on_next);
    parent(0);

    next_lbl = alloc();
    target(next_lbl);
    set(kind, KIND_LABEL);
    set(size, 200, 80);
    set(text, "Next");
    set(text_color, WHITE);
    set(text_align, ALIGN_CENTER);
    parent(next_btn);

    grid = alloc();
    target(grid);
    set(location, 0, TOP);
    set(size, SCREEN_W, SCREEN_H - TOP);
    parent(0);

    var i = 0;
    while (i < COLS * ROWS) {
        var b = alloc();
        target(b);
        set(location, (i % COLS) * BOX_W, (i / COLS) * BOX_H);
        set(size, BOX_W - 4, BOX_H - 4);
        parent(grid);
        boxes[i] = b;
        i = i + 1;
    }

    show_mode();
    return 0;
}

fn report(unit: string) {
    var now = millis();
    var dt = now - since;
    if (dt >= 1000) {
        target(rate_lbl);
        set(text, sprintf("%d %s/s", count * 1000 / dt, unit));
        strClear();
        count = 0;
        since = now;
    }
}

fn loop() {
    if (mode == 0) {
        var i = 0;
        var acc = 0;
        while (i < VM_CHUNK) {
            acc = acc + (i * 7) % 13;
            i = i + 1;
        }
        count = count + VM_CHUNK;
        report("loop iterations");
    } else if (mode == 1) {
        var k = 0;
        while (k < COLS * ROWS) {
            target(boxes[k]);
            set(bg_color, ((k + phase) * 0x0841) & 0xFFFF);
            k = k + 1;
        }
        phase = phase + 1;
        count = count + 1;
        report("frames");
    } else if (mode == 2) {
        fillRect(0, TOP, SCREEN_W, SCREEN_H - TOP, (phase * 0x1863) & 0xFFFF);
        phase = phase + 1;
        count = count + 1;
        report("fills");
    } else {
        count = count + 1;
        report("passes");
    }
}
