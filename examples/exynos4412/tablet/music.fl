// music.fl — a music player for the three synthesized tracks: play /
// pause, previous / next, progress, volume, a track list and a bar
// visualizer. A track that ends moves on to the next one.
#include "ui.fl"

const NTRACK = 3;
const BARS = 14;

var art; var art_icon;
var bars[14];
var title_lbl; var artist_lbl; var prog; var pos_lbl; var len_lbl;
var play_btn; var play_icon; var prev_btn; var next_btn;
var vol_sl; var vol_lbl;
var row0; var row1; var row2;
var row_lbl[3];

var track = 0;
var playing = 0;
var started = 0;       // millis() at the start of the track minus the paused time
var paused_at = 0;
var seed = 12345;

fn track_sound(i) -> string {
    if (i == 0) { return str("track1"); }
    if (i == 1) { return str("track2"); }
    return str("track3");
}

fn track_title(i) -> string {
    if (i == 0) { return str("Morning Light"); }
    if (i == 1) { return str("City Drive"); }
    return str("Slow Tide");
}

fn track_ms(i) {
    if (i == 0) { return 10000; }
    if (i == 1) { return 8276; }
    return 11429;
}

fn track_color(i) {
    if (i == 0) { return 0xFB60; }
    if (i == 1) { return 0xA21E; }
    return 0x14D9;
}

fn rnd(n) {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF;
    return (seed >> 8) % n;
}

fn fmt_time(ms) -> string {
    var s = ms / 1000;
    return sprintf("%d:%02d", s / 60, s % 60);
}

fn make_row(r: widget, i) {
    target(r);
    style_button(64, 596 + i * 52, 420, 46, SURFACE, 14);
    parent(0);
    var l = alloc();
    style_label(20, 0, 380, 46, F20, WHITE, ALIGN_LEFT, track_title(i));
    parent(r);
    row_lbl[i] = l;
}

fn elapsed() {
    return playing ? millis() - started : paused_at;
}

fn show_track() {
    var c = track_color(track);
    target(art);
    set(bg_color, c);
    set(gradient_color, darken(darken(c)));
    dirty();
    target(title_lbl); set(text, track_title(track)); dirty();
    target(len_lbl); set(text, fmt_time(track_ms(track))); dirty();
    for (var i = 0; i < NTRACK; i++) {
        target(row_lbl[i]);
        set(text_color, i == track ? lighten(c) : WHITE);
        dirty();
    }
    strClear();
}

fn show_play() {
    target(play_icon);
    set(image_id, playing ? IMG_PAUSE : IMG_PLAY);
    dirty();
    for (var i = 0; i < BARS; i++) {
        var b = bars[i];
        if (playing) {
            // Height and top together, same timing: the bar grows up from
            // the baseline.
            var h = 20 + rnd(120);
            var d = 180 + rnd(260);
            animate(b, PROP_SIZE_H, h, d, EASE_IN_OUT | REPEAT_YOYO);
            animate(b, PROP_LOC_Y, 150 - h, d, EASE_IN_OUT | REPEAT_YOYO);
        } else {
            stopAnim(b);
            target(b);
            set(location, i * 24 + 5, 140);
            set(size, 14, 10);
            dirty();
        }
    }
}

fn show_pos() {
    var t = elapsed();
    var len = track_ms(track);
    if (t > len) {
        t = len;
    }
    target(prog); set(value, t * 100 / len); dirty();
    target(pos_lbl); set(text, fmt_time(t)); dirty();
    strClear();
}

fn start(i) {
    track = (i + NTRACK) % NTRACK;
    playSound(track_sound(track));
    started = millis();
    paused_at = 0;
    playing = 1;
    show_track();
    show_play();
    show_pos();
}

// One sound at a time and no seek: pause stops it and play restarts the
// track from the beginning if it was paused.
fn toggle_play() {
    if (playing) {
        stopSound();
        paused_at = millis() - started;
        playing = 0;
        show_play();
    } else {
        start(track);
    }
}

fn on_play(w) { toggle_play(); }
fn on_prev(w) { start(track - 1); }
fn on_next(w) { start(track + 1); }

fn on_row(w) {
    if (w == row0) { start(0); }
    if (w == row1) { start(1); }
    if (w == row2) { start(2); }
}

fn on_vol(w, v) {
    ui_volume = v;
    setVolume(v);
    target(vol_lbl); set(text, sprintf("%d%%", v)); dirty();
    ui_status_levels();
    strClear();
}

fn setup() {
    ui_app(APP_MUSIC, "Music");

    art = alloc();
    style_box(64, 140, 420, 420, C_MUSIC, 36);
    set(gradient_dir, 2);
    parent(0);
    art_icon = alloc();
    style_image(150, 90, 120, 120, IMG_APP_MUSIC);
    parent(art);
    var stage = alloc();
    target(stage);
    set(kind, KIND_LABEL);
    set(location, 40, 230);
    set(size, 340, 150);
    parent(art);
    for (var i = 0; i < BARS; i++) {
        var b = alloc();
        style_box(i * 24 + 5, 140, 14, 10, WHITE, 7);
        set(alpha, 170);
        parent(stage);
        bars[i] = b;
    }

    title_lbl = alloc();
    style_label(560, 150, 680, 60, F36, WHITE, ALIGN_LEFT, "");
    parent(0);
    artist_lbl = alloc();
    style_label(562, 210, 680, 36, F20, DIM, ALIGN_LEFT, "ferrite synth  ·  synthesized at build time");
    parent(0);

    prog = alloc();
    target(prog);
    set(kind, KIND_PROGRESS);
    set(location, 560, 300);
    set(size, 660, 12);
    set(bg_color, SURFACE_HI);
    set(press_color, C_MUSIC);
    set(border_radius, 6);
    parent(0);
    pos_lbl = alloc();
    style_label(560, 322, 200, 30, F20, DIM, ALIGN_LEFT, "0:00");
    parent(0);
    len_lbl = alloc();
    style_label(1020, 322, 200, 30, F20, DIM, ALIGN_RIGHT, "");
    parent(0);

    prev_btn = alloc();
    style_button(700, 400, 96, 96, SURFACE, 48);
    set(on_click, @on_prev);
    parent(0);
    add_icon(prev_btn, 96, 96, IMG_PREV);
    play_btn = alloc();
    style_button(834, 380, 136, 136, C_MUSIC, 68);
    set(on_click, @on_play);
    parent(0);
    play_icon = alloc();
    style_image(0, 0, 136, 136, IMG_PLAY);
    parent(play_btn);
    next_btn = alloc();
    style_button(1008, 400, 96, 96, SURFACE, 48);
    set(on_click, @on_next);
    parent(0);
    add_icon(next_btn, 96, 96, IMG_NEXT);

    var vi = alloc();
    style_image(560, 590, 40, 44, IMG_QS_VOLUME);
    parent(0);
    vol_sl = alloc();
    style_slider(616, 596, 500, C_MUSIC);
    set(value, ui_volume);
    set(on_click, @on_vol);
    parent(0);
    vol_lbl = alloc();
    style_label(1130, 590, 90, 44, F20, WHITE, ALIGN_RIGHT, sprintf("%d%%", ui_volume));
    parent(0);

    row0 = alloc(); make_row(row0, 0); target(row0); set(on_click, @on_row);
    row1 = alloc(); make_row(row1, 1); target(row1); set(on_click, @on_row);
    row2 = alloc(); make_row(row2, 2); target(row2); set(on_click, @on_row);
    show_track();
    show_pos();
    return 0;
}

var last_pos = 0;

fn loop() {
    ui_tick();
    if (playing) {
        if (!soundPlaying() && millis() - started > 500) {
            start(track + 1);
        }
        var t = millis();
        if (t - last_pos >= 250) {
            last_pos = t;
            show_pos();
        }
    }
    delay(30);
}
