// calc.fl — calculator: float arithmetic, an expression line, typed
// digits shown exactly as entered, chained operations (12 + 3 × 2 = 30,
// like a pocket calculator).
#include "ui.fl"

const KEY_W = 291;
const KEY_H = 76;
const GAP = 10;
const PAD_X = 24 + 0;
const PAD_Y = 330;

const OP_NONE = 0;
const OP_ADD = 1;
const OP_SUB = 2;
const OP_MUL = 3;
const OP_DIV = 4;

var expr_lbl; var res_lbl;
var k0; var k1; var k2; var k3; var k4; var k5; var k6; var k7; var k8; var k9; var k10; var k11; var k12; var k13; var k14; var k15; var k16; var k17; var k18; var k19;

var acc = 0.0;          // left operand
var op = 0;             // pending operator
var typing = 0;         // digits are being entered
var ent_m = 0;          // entered digits as an integer
var ent_dec = -1;       // digits after the point, -1 = no point yet
var ent_neg = 0;
var shown = 0.0;        // value on the display when not typing
var error = 0;

fn op_char(o) -> string {
    if (o == OP_ADD) { return str("+"); }
    if (o == OP_SUB) { return str("−"); }
    if (o == OP_MUL) { return str("×"); }
    return str("÷");
}

fn pow10(n) {
    var p = 1;
    for (var i = 0; i < n; i++) {
        p = p * 10;
    }
    return p;
}

// The entered number as typed ("0.50" keeps its zero).
fn entry_text() -> string {
    var s;
    if (ent_dec <= 0) {
        s = sprintf("%d", ent_m);
        if (ent_dec == 0) {
            s = strcat(s, ".");
        }
    } else {
        var p = pow10(ent_dec);
        var fmt = sprintf("%%d.%%0%dd", ent_dec);
        s = sprintf(fmt, ent_m / p, ent_m % p);
    }
    if (ent_neg) {
        s = strcat("-", s);
    }
    return s;
}

fn entry_value() -> float {
    var v = itof(ent_m) / itof(pow10(ent_dec < 0 ? 0 : ent_dec));
    return ent_neg ? 0.0 - v : v;
}

// A float with up to 6 decimals, trailing zeros dropped.
fn fmt_num(v: float) -> string {
    var neg = v < 0.0;
    var a = neg ? 0.0 - v : v;
    if (a >= 2000000000.0) {
        return str("Too large");
    }
    var ip = ftoi(a);
    var fr = ftoi((a - itof(ip)) * 1000000.0 + 0.5);
    if (fr >= 1000000) {
        ip = ip + 1;
        fr = fr - 1000000;
    }
    var nd = 6;
    while (nd > 0 && fr % 10 == 0) {
        fr = fr / 10;
        nd--;
    }
    var s;
    if (nd == 0) {
        s = sprintf("%d", ip);
    } else {
        s = sprintf(sprintf("%%d.%%0%dd", nd), ip, fr);
    }
    if (neg && (ip != 0 || fr != 0)) {
        s = strcat("-", s);
    }
    return s;
}

fn show() {
    target(res_lbl);
    if (error) {
        set(text, "Error");
    } else if (typing) {
        set(text, entry_text());
    } else {
        set(text, fmt_num(shown));
    }
    dirty();
    target(expr_lbl);
    if (op != OP_NONE) {
        set(text, sprintf("%s %s", fmt_num(acc), op_char(op)));
    } else {
        set(text, "");
    }
    dirty();
    strClear();
}

fn current() -> float {
    return typing ? entry_value() : shown;
}

fn apply(a: float, o, b: float) -> float {
    if (o == OP_ADD) { return a + b; }
    if (o == OP_SUB) { return a - b; }
    if (o == OP_MUL) { return a * b; }
    if (o == OP_DIV) {
        if (b == 0.0) {
            error = 1;
            return 0.0;
        }
        return a / b;
    }
    return b;
}

fn start_entry() {
    if (!typing) {
        typing = 1;
        ent_m = 0;
        ent_dec = -1;
        ent_neg = 0;
    }
}

fn digit(d) {
    start_entry();
    if (ent_m >= 100000000) {
        return 0;   // 9 digits
    }
    ent_m = ent_m * 10 + d;
    if (ent_dec >= 0) {
        ent_dec++;
    }
}

fn press_op(o) {
    var v = current();
    if (op != OP_NONE && typing) {
        acc = apply(acc, op, v);
    } else if (op == OP_NONE) {
        acc = v;
    }
    shown = acc;
    op = o;
    typing = 0;
}

fn equals() {
    if (op == OP_NONE) {
        shown = current();
    } else {
        shown = apply(acc, op, current());
    }
    op = OP_NONE;
    typing = 0;
}

fn key(i) {
    if (error && i != 0) {
        return 0;
    }
    if (i == 0) {
        acc = 0.0; op = OP_NONE; typing = 0; shown = 0.0; error = 0;
    } else if (i == 1) {
        if (typing) {
            ent_neg = !ent_neg;
        } else {
            shown = 0.0 - shown;
        }
    } else if (i == 2) {
        // Percent: of the left operand for + and -, else / 100.
        var v = current();
        if (op == OP_ADD || op == OP_SUB) {
            shown = acc * v / 100.0;
        } else {
            shown = v / 100.0;
        }
        typing = 0;
    } else if (i == 3) { press_op(OP_DIV);
    } else if (i == 7) { press_op(OP_MUL);
    } else if (i == 11) { press_op(OP_SUB);
    } else if (i == 15) { press_op(OP_ADD);
    } else if (i == 16) { digit(0);
    } else if (i == 17) {
        start_entry();
        if (ent_dec < 0) {
            ent_dec = 0;
        }
    } else if (i == 18) {
        if (typing) {
            if (ent_dec > 0) {
                ent_m = ent_m / 10;
                ent_dec--;
            } else if (ent_dec == 0) {
                ent_dec = -1;
            } else {
                ent_m = ent_m / 10;
            }
        }
    } else if (i == 19) {
        equals();
    } else {
        // Digit keys: rows 7 8 9 / 4 5 6 / 1 2 3
        var row = i / 4 - 1;
        var col = i % 4;
        digit((2 - row) * 3 + col + 1);
    }
    show();
}

fn key_color(i) {
    if (i == 19) { return C_CALC; }
    if (i % 4 == 3) { return 0x4A49; }
    if (i < 3) { return SURFACE_HI; }
    return SURFACE;
}

fn make_key(k: widget, i, label) {
    var c = key_color(i);
    target(k);
    style_button(PAD_X + (i % 4) * (KEY_W + GAP) + 16, PAD_Y + (i / 4) * (KEY_H + GAP) - 8, KEY_W, KEY_H, c, 24);
    set(kind, KIND_LABEL);
    set(font_id, F36);
    set(text_color, (i % 4 == 3 && i != 19) ? 0xFE4C : WHITE);
    set(text_align, ALIGN_CENTER);
    set(text, label);
    parent(0);
}

fn key_index(w) {
    if (w == k0) { return 0; }
    if (w == k1) { return 1; }
    if (w == k2) { return 2; }
    if (w == k3) { return 3; }
    if (w == k4) { return 4; }
    if (w == k5) { return 5; }
    if (w == k6) { return 6; }
    if (w == k7) { return 7; }
    if (w == k8) { return 8; }
    if (w == k9) { return 9; }
    if (w == k10) { return 10; }
    if (w == k11) { return 11; }
    if (w == k12) { return 12; }
    if (w == k13) { return 13; }
    if (w == k14) { return 14; }
    if (w == k15) { return 15; }
    if (w == k16) { return 16; }
    if (w == k17) { return 17; }
    if (w == k18) { return 18; }
    if (w == k19) { return 19; }
    return -1;
}

fn on_key(w) {
    playSound("click");
    var i = key_index(w);
    if (i >= 0) {
        key(i);
    }
}

fn setup() {
    ui_app(APP_CALC, "Calculator");
    var disp = alloc();
    style_box(40, 128, 1200, 180, SURFACE, 28);
    parent(0);
    expr_lbl = alloc();
    style_label(32, 16, 1136, 50, F36, DIM, ALIGN_RIGHT, "");
    parent(disp);
    res_lbl = alloc();
    style_label(32, 70, 1136, 96, F60, WHITE, ALIGN_RIGHT, "0");
    parent(disp);
    k0 = alloc(); make_key(k0, 0, "C"); target(k0); set(on_click, @on_key);
    k1 = alloc(); make_key(k1, 1, "+/−"); target(k1); set(on_click, @on_key);
    k2 = alloc(); make_key(k2, 2, "%"); target(k2); set(on_click, @on_key);
    k3 = alloc(); make_key(k3, 3, "÷"); target(k3); set(on_click, @on_key);
    k4 = alloc(); make_key(k4, 4, "7"); target(k4); set(on_click, @on_key);
    k5 = alloc(); make_key(k5, 5, "8"); target(k5); set(on_click, @on_key);
    k6 = alloc(); make_key(k6, 6, "9"); target(k6); set(on_click, @on_key);
    k7 = alloc(); make_key(k7, 7, "×"); target(k7); set(on_click, @on_key);
    k8 = alloc(); make_key(k8, 8, "4"); target(k8); set(on_click, @on_key);
    k9 = alloc(); make_key(k9, 9, "5"); target(k9); set(on_click, @on_key);
    k10 = alloc(); make_key(k10, 10, "6"); target(k10); set(on_click, @on_key);
    k11 = alloc(); make_key(k11, 11, "−"); target(k11); set(on_click, @on_key);
    k12 = alloc(); make_key(k12, 12, "1"); target(k12); set(on_click, @on_key);
    k13 = alloc(); make_key(k13, 13, "2"); target(k13); set(on_click, @on_key);
    k14 = alloc(); make_key(k14, 14, "3"); target(k14); set(on_click, @on_key);
    k15 = alloc(); make_key(k15, 15, "+"); target(k15); set(on_click, @on_key);
    k16 = alloc(); make_key(k16, 16, "0"); target(k16); set(on_click, @on_key);
    k17 = alloc(); make_key(k17, 17, "."); target(k17); set(on_click, @on_key);
    k18 = alloc(); make_key(k18, 18, "DEL"); target(k18); set(on_click, @on_key);
    k19 = alloc(); make_key(k19, 19, "="); target(k19); set(on_click, @on_key);
    show();
    return 0;
}

fn loop() {
    ui_tick();
    delay(200);
}
