// monitor.fl — live system figures from the sysinfo syscalls: frames and
// main-loop passes per second (graphs), heap and object arena use, object
// counts, CPU clock, uptime. "Stress" sets a field of tiles bouncing to
// load the renderer and shows what that does to the figures.
#include "ui.fl"

const HIST = 60;
const TILES = 24;

var fps_hist[60];
var pps_hist[60];
var fps_graph; var fps_big; var fps_sub;
var pps_graph; var pps_big; var pps_sub;
var heap_bar; var heap_lbl;
var arena_bar; var arena_lbl;
var cnt_lbl; var cpu_lbl; var up_lbl;
var stress_btn; var stress_txt;
var stage;
var tiles[24];

var seeded = 0;
var last_t = 0;
var last_frames = 0;
var last_passes = 0;
var fps_max = 0;
var stress = 0;

fn card(x, y, w, h, title) {
    var c = alloc();
    style_box(x, y, w, h, SURFACE, 24);
    parent(0);
    var t = alloc();
    style_label(24, 14, w - 48, 30, F20, DIM, ALIGN_LEFT, title);
    parent(c);
    return c;
}

fn style_graph(color, fill) {
    set(kind, KIND_GRAPH);
    set(alpha, 0);
    set(text_color, color);
    set(gradient_color, fill);
    set(graph_flags, 2);
}

fn style_bar(x, y, w, color) {
    set(kind, KIND_PROGRESS);
    set(location, x, y);
    set(size, w, 16);
    set(bg_color, SURFACE_HI);
    set(press_color, color);
    set(border_radius, 8);
    set(value, 0);
}

fn build() {
    // Frames per second
    var c1: widget = card(24, 128, 600, 300, "Frames per second");
    fps_big = alloc();
    style_label(24, 44, 300, 70, F60, WHITE, ALIGN_LEFT, "-");
    parent(c1);
    fps_sub = alloc();
    style_label(300, 64, 276, 40, F20, DIM, ALIGN_RIGHT, "");
    parent(c1);
    fps_graph = alloc();
    target(fps_graph);
    set(location, 24, 124);
    set(size, 552, 156);
    style_graph(ACCENT, 0x2A4F);
    set(graph_arr, fps_hist);
    parent(c1);

    // Loop passes per second
    var c2: widget = card(656, 128, 600, 300, "Main-loop passes per second");
    pps_big = alloc();
    style_label(24, 44, 300, 70, F60, WHITE, ALIGN_LEFT, "-");
    parent(c2);
    pps_sub = alloc();
    style_label(300, 64, 276, 40, F20, DIM, ALIGN_RIGHT, "");
    parent(c2);
    pps_graph = alloc();
    target(pps_graph);
    set(location, 24, 124);
    set(size, 552, 156);
    style_graph(0x47EA, 0x1265);
    set(graph_arr, pps_hist);
    parent(c2);

    // Memory
    var c3: widget = card(24, 448, 600, 300, "Memory");
    heap_lbl = alloc();
    style_label(24, 54, 552, 30, F20, WHITE, ALIGN_LEFT, "");
    parent(c3);
    heap_bar = alloc();
    style_bar(24, 92, 552, ACCENT);
    parent(c3);
    arena_lbl = alloc();
    style_label(24, 128, 552, 30, F20, WHITE, ALIGN_LEFT, "");
    parent(c3);
    arena_bar = alloc();
    style_bar(24, 166, 552, ORANGE);
    parent(c3);
    cnt_lbl = alloc();
    style_label(24, 206, 552, 30, F20, DIM, ALIGN_LEFT, "");
    parent(c3);
    cpu_lbl = alloc();
    style_label(24, 240, 552, 30, F20, DIM, ALIGN_LEFT, "");
    parent(c3);

    // Stress stage
    var c4: widget = card(656, 448, 600, 300, "Renderer load");
    up_lbl = alloc();
    style_label(300, 14, 276, 30, F20, DIM, ALIGN_RIGHT, "");
    parent(c4);
    stage = alloc();
    target(stage);
    set(kind, KIND_LABEL);
    set(location, 24, 56);
    set(size, 552, 160);
    parent(c4);
    for (var i = 0; i < TILES; i++) {
        var t = alloc();
        style_box((i % 24) * 23, (i % 2) * 124, 20, 36, app_color(i % 8 + 1), 8);
        set(visible, OFF);
        parent(stage);
        tiles[i] = t;
    }
    stress_btn = alloc();
    style_button(24, 222, 552, 56, SURFACE_HI, 28);
    parent(c4);
    stress_txt = alloc();
    style_label(0, 0, 552, 56, F26, WHITE, ALIGN_CENTER, "Start stress test");
    parent(stress_btn);
}

fn set_stress(on) {
    stress = on;
    for (var i = 0; i < TILES; i++) {
        var t = tiles[i];
        target(t);
        set(visible, on);
        dirty();
        if (on) {
            // Each tile bounces down and back at its own pace.
            animate(t, PROP_LOC_Y, (i % 2) ? 0 : 124, 500 + (i % 7) * 90, EASE_IN_OUT | REPEAT_YOYO);
        } else {
            stopAnim(t);
            set(location, (i % 24) * 23, (i % 2) * 124);
        }
    }
    target(stress_btn);
    set(bg_color, on ? C_MONITOR : SURFACE_HI);
    set(press_color, lighten(on ? C_MONITOR : SURFACE_HI));
    dirty();
    target(stress_txt);
    set(text, on ? "Stop stress test" : "Start stress test");
    dirty();
}

fn on_stress(w) {
    playSound("click");
    set_stress(!stress);
}

// Shift both histories left and append (the first sample fills them).
fn push(fps, pps) {
    for (var i = 0; i < HIST - 1; i++) {
        fps_hist[i] = seeded ? fps_hist[i + 1] : fps;
        pps_hist[i] = seeded ? pps_hist[i + 1] : pps;
    }
    fps_hist[HIST - 1] = fps;
    pps_hist[HIST - 1] = pps;
}

fn pct(used, total) {
    return total > 0 ? used * 100 / total : 0;
}

fn sample() {
    var t = millis();
    var dt = t - last_t;
    var f = sysFrames();
    var p = sysPasses();
    var fps = (f - last_frames) * 1000 / dt;
    var pps = (p - last_passes) * 1000 / dt;
    last_t = t;
    last_frames = f;
    last_passes = p;
    if (fps > fps_max) {
        fps_max = fps;
    }
    push(fps, pps);
    seeded = 1;

    target(fps_big); set(text, sprintf("%d", fps)); dirty();
    target(fps_sub); set(text, sprintf("peak %d", fps_max)); dirty();
    target(fps_graph); dirty();
    target(pps_big); set(text, sprintf("%d", pps)); dirty();
    target(pps_sub); set(text, sprintf("%d us per pass", pps > 0 ? 1000000 / pps : 0)); dirty();
    target(pps_graph); dirty();

    var hu = sysHeapUsedKb();
    var ht = sysHeapTotalKb();
    target(heap_lbl);
    if (ht > 0) {
        set(text, sprintf("Heap  %d.%d / %d MB", hu / 1024, (hu % 1024) * 10 / 1024, ht / 1024));
    } else {
        set(text, "Heap  (not reported)");
    }
    dirty();
    target(heap_bar); set(value, pct(hu, ht)); dirty();
    var au = sysObjUsedKb();
    var at = sysObjTotalKb();
    target(arena_lbl); set(text, sprintf("Object arena  %d / %d KB", au, at)); dirty();
    target(arena_bar); set(value, pct(au, at)); dirty();
    target(cnt_lbl);
    set(text, sprintf("%d widgets  ·  %d strings  ·  %d arrays", sysObjCount(1), sysObjCount(2), sysObjCount(3)));
    dirty();
    var mhz = sysCpuMhz();
    target(cpu_lbl);
    if (mhz > 0) {
        set(text, sprintf("CPU0  %d MHz  ·  Cortex-A9", mhz));
    } else {
        set(text, "CPU0  (clock not reported)");
    }
    dirty();
    var s = t / 1000;
    target(up_lbl); set(text, sprintf("up %d:%02d:%02d", s / 3600, (s / 60) % 60, s % 60)); dirty();
    strClear();
}

fn setup() {
    ui_app(APP_MONITOR, "Monitor");
    build();
    target(stress_btn); set(on_click, @on_stress);
    last_t = millis();
    last_frames = sysFrames();
    last_passes = sysPasses();
    return 0;
}

var next_sample = 0;

fn loop() {
    ui_tick();
    var t = millis();
    if (t >= next_sample) {
        if (next_sample != 0) {
            sample();
        }
        next_sample = t + 1000;
    }
    delay(20);
}
