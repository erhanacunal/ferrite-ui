// main.fl — Launcher (1280x800, Exynos 4412 tablet)
//
// The image holds several programs; this one (`main`) starts at boot and
// shows a tile for every other one, found with programName(i). Tapping a tile
// calls runProgram(name, arg): this program ends there and the app starts
// from scratch. Apps come back with runProgram("main", result), and the
// launcher shows what they passed (programArg()).

#include "core.fl"
#include "color.fl"

const TILES = 4;
const TILE_W = 260;
const TILE_H = 160;
const GAP = 40;

// Program index shown on each tile (-1 = tile unused).
var tile_prog[4] = [-1, -1, -1, -1];
// set(on_click) wires file-scope widget variables: one per tile.
var tile0;
var tile1;
var tile2;
var tile3;

fn tile(t: widget, slot, name) {
    var x = (1280 - TILES * TILE_W - (TILES - 1) * GAP) / 2 + slot * (TILE_W + GAP);
    target(t);
    set(location, x, 320);
    set(size, TILE_W, TILE_H);
    set(bg_color, 0x2945);
    set(press_color, 0x2C9F);
    set(border_radius, 16);
    set(clickable, ON);
    parent(0);
    var l = alloc();
    target(l);
    set(kind, KIND_LABEL);
    set(size, TILE_W, TILE_H);
    set(text, name);
    set(text_color, WHITE);
    set(text_align, ALIGN_CENTER);
    parent(t);
}

fn launch(slot) {
    var i = tile_prog[slot];
    if (i >= 0) {
        // Ends this program here if the app exists. The app gets the last
        // app's result, so the counter goes on from where it stopped.
        runProgram(programName(i), programArg());
        sendUsart("launch failed\r\n");
    }
}

fn on_tile(wid) {
    if (wid == tile0) { launch(0); }
    if (wid == tile1) { launch(1); }
    if (wid == tile2) { launch(2); }
    if (wid == tile3) { launch(3); }
}

fn setup() {
    var title = alloc();
    target(title);
    set(kind, KIND_LABEL);
    set(location, 0, 80);
    set(size, 1280, 60);
    set(text, "Apps");
    set(text_color, WHITE);
    set(text_align, ALIGN_CENTER);
    parent(0);

    var info = alloc();
    target(info);
    set(kind, KIND_LABEL);
    set(location, 0, 160);
    set(size, 1280, 40);
    set(text_color, GREEN);
    set(text_align, ALIGN_CENTER);
    parent(0);
    // At boot programArg() is 0; an app coming back passes its result.
    if (programArg() == 0) {
        set(text, "Tap an app");
    } else {
        set(text, sprintf("The last app returned %d", programArg()));
    }

    // Every program but this one gets a tile, in image order.
    var slot = 0;
    var i = 0;
    var name = programName(0);
    while (strLen(name) > 0 && slot < TILES) {
        if (strcmp(name, programName(-1)) != 0) {
            tile_prog[slot] = i;
            slot = slot + 1;
        }
        i = i + 1;
        name = programName(i);
    }

    tile0 = alloc();
    tile1 = alloc();
    tile2 = alloc();
    tile3 = alloc();
    if (tile_prog[0] >= 0) { tile(tile0, 0, programName(tile_prog[0])); }
    if (tile_prog[1] >= 0) { tile(tile1, 1, programName(tile_prog[1])); }
    if (tile_prog[2] >= 0) { tile(tile2, 2, programName(tile_prog[2])); }
    if (tile_prog[3] >= 0) { tile(tile3, 3, programName(tile_prog[3])); }
    target(tile0);
    set(on_click, @on_tile);
    target(tile1);
    set(on_click, @on_tile);
    target(tile2);
    set(on_click, @on_tile);
    target(tile3);
    set(on_click, @on_tile);
    return 0;
}

fn loop() {
}
