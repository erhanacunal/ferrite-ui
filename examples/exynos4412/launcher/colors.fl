// colors.fl — an app of the launcher example.
//
// Cycles a big panel through a few colours while it runs; Home goes back to
// the launcher, passing the number of colours shown.

#include "core.fl"
#include "color.fl"

var colors[6] = [RED, GREEN, BLUE, YELLOW, CYAN, MAGENTA];
var shown = 0;
var panel;
// set(on_click) wires file-scope widget variables.
var home_btn;

fn on_home(wid) {
    runProgram("main", shown);
}

fn setup() {
    panel = alloc();
    target(panel);
    set(location, 140, 80);
    set(size, 1000, 500);
    set(bg_color, colors[0]);
    set(border_radius, 24);
    parent(0);

    home_btn = alloc();
    target(home_btn);
    set(location, 40, 640);
    set(size, 300, 120);
    set(bg_color, 0x2945);
    set(press_color, 0x2C9F);
    set(border_radius, 16);
    set(clickable, ON);
    set(on_click, @on_home);
    parent(0);
    var l = alloc();
    target(l);
    set(kind, KIND_LABEL);
    set(size, 300, 120);
    set(text, "Home");
    set(text_color, WHITE);
    set(text_align, ALIGN_CENTER);
    parent(home_btn);
    return 0;
}

fn loop() {
    delay(700);
    shown = shown + 1;
    target(panel);
    set(bg_color, colors[shown % 6]);
}
