// worker.fl — child task of the multitask example, without widgets.
//
// Sends main (task 0) a message every second: a = a counter, b = its square.
// After 30 messages it ends itself; main's on_task_exit sees code 0.

#include "core.fl"

var n;

fn setup() {
    return 0;
}

fn loop() {
    n = n + 1;
    sendMessage(0, n, n * n);
    if (n >= 30) {
        killProgram(taskId());
    }
    delay(1000);
}
