// ticker.fl — child task of the multitask example.
//
// Adds a panel to the shared widget tree at y = programArg() and counts in
// it. The panel is this task's: it is removed when the task ends.

#include "core.fl"
#include "color.fl"

var count;
var panel;
var lbl;

fn setup() {
    panel = alloc();
    target(panel);
    set(location, 240, programArg());
    set(size, 800, 160);
    set(bg_color, 0x18C6);
    set(border_radius, 16);
    parent(0);
    lbl = alloc();
    target(lbl);
    set(kind, KIND_LABEL);
    set(size, 800, 160);
    set(text_color, CYAN);
    set(text_align, ALIGN_CENTER);
    parent(panel);
    return 0;
}

fn loop() {
    target(lbl);
    set(text, sprintf("ticker (task %d): %d", taskId(), count));
    strClear();
    count = count + 1;
    delay(100);
}
