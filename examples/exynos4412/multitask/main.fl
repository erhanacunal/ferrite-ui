// main.fl — multitask example (1280x800, Exynos 4412 tablet)
//
// Several programs run at once on one widget tree. main starts two child
// tasks with spawnProgram(): `ticker` draws a counting panel of its own, and
// `worker` sends main a message every second. Tapping "Stop ticker" kills
// the ticker (its widgets go away with it, on_task_exit reports it), "Start
// ticker" spawns it again.

#include "core.fl"
#include "color.fl"

var ticker = -1;
var worker = -1;
var status_lbl;
var msg_lbl;
var toggle_btn;
var toggle_lbl;

fn show_toggle() {
    target(toggle_lbl);
    if (taskAlive(ticker)) {
        set(text, "Stop ticker");
    } else {
        set(text, "Start ticker");
    }
}

fn on_toggle(wid) {
    if (taskAlive(ticker)) {
        killProgram(ticker);
    } else {
        // The ticker gets its panel position as programArg().
        ticker = spawnProgram("ticker", 400);
    }
    show_toggle();
}

// From a child: from = its task id, a/b = its values.
fn on_task_message(from, a, b) {
    target(msg_lbl);
    set(text, sprintf("Task %d says %d (%d)", from, a, b));
    strClear();
}

// code: 0 = ended or killed, > 0 = VM fault, -1 = did not start.
fn on_task_exit(task, code) {
    target(status_lbl);
    set(text, sprintf("Task %d ended, code %d", task, code));
    strClear();
    if (task == ticker) {
        show_toggle();
    }
}

fn setup() {
    var title = alloc();
    target(title);
    set(kind, KIND_LABEL);
    set(location, 0, 40);
    set(size, 1280, 60);
    set(text, sprintf("main is task %d", taskId()));
    set(text_color, WHITE);
    set(text_align, ALIGN_CENTER);
    parent(0);

    msg_lbl = alloc();
    target(msg_lbl);
    set(kind, KIND_LABEL);
    set(location, 0, 120);
    set(size, 1280, 40);
    set(text, "No message yet");
    set(text_color, GREEN);
    set(text_align, ALIGN_CENTER);
    parent(0);

    status_lbl = alloc();
    target(status_lbl);
    set(kind, KIND_LABEL);
    set(location, 0, 180);
    set(size, 1280, 40);
    set(text_color, YELLOW);
    set(text_align, ALIGN_CENTER);
    parent(0);

    toggle_btn = alloc();
    target(toggle_btn);
    set(location, 440, 640);
    set(size, 400, 120);
    set(bg_color, 0x2945);
    set(press_color, 0x2C9F);
    set(border_radius, 16);
    set(clickable, ON);
    parent(0);
    toggle_lbl = alloc();
    target(toggle_lbl);
    set(kind, KIND_LABEL);
    set(size, 400, 120);
    set(text_color, WHITE);
    set(text_align, ALIGN_CENTER);
    parent(toggle_btn);
    target(toggle_btn);
    set(on_click, @on_toggle);

    ticker = spawnProgram("ticker", 400);
    worker = spawnProgram("worker");
    target(status_lbl);
    set(text, sprintf("Started ticker = %d, worker = %d", ticker, worker));
    show_toggle();
    return 0;
}

fn loop() {
}
