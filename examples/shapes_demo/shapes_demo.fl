#include "shapes.fl"

fn setup() {
    layout();
    render();
    return 0;
}

fn loop() {}

fn layout() {
    var rect = alloc();
    rect.kind = KIND_RECTANGLE;
    rect.location = [20, 20];
    rect.size = [120, 80];
    rect.bg_color = 0x001F;
    rect.border_color = 0xFFFF;
    rect.border = [3, 3, 3, 3];
    rect.border_radius = 10;
    parent(0);

    var circ = alloc();
    circ.kind = KIND_CIRCLE;
    circ.location = [180, 20];
    circ.size = [90, 90];
    circ.bg_color = 0xF800;
    circ.border_color = 0xFFFF;
    circ.border = [2, 2, 2, 2];
    parent(0);

    var tri = alloc();
    tri.kind = KIND_POLYGON;
    tri.location = [40, 140];
    tri.size = [120, 100];
    tri.text = "10,5 110,5 60,95";
    tri.bg_color = 0x07E0;
    tri.border_color = 0xFFFF;
    tri.border = [2, 2, 2, 2];
    parent(0);

    var ln = alloc();
    ln.kind = KIND_LINE;
    ln.location = [200, 140];
    ln.size = [120, 100];
    ln.border_color = 0xFFE0;
    ln.border = [3, 3, 3, 3];
    parent(0);

    var ell = alloc();
    ell.kind = KIND_ELLIPSE;
    ell.location = [120, 280];
    ell.size = [200, 120];
    ell.bg_color = 0x780F;
    ell.border_color = 0xFFFF;
    ell.border = [3, 3, 3, 3];
    parent(0);
}
