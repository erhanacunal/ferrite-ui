// demo.fl — Ferrite UI Widget Showcase (800x480)
//
// 4-tab demo: Buttons, Sliders, Checkbox/Radio, Canvas
// Demonstrates all widget types and drawing primitives.

// ── Globals (24 of 32 slots) ──
var panel1;         // tab panels
var panel2;
var panel3;
var panel4;
var tab1;           // tab buttons
var tab2;
var tab3;
var tab4;
var active_tab;
var counter;        // tab 1
var counter_lbl;
var status_lbl;
var prog1;          // tab 2
var prog2;
var prog3;
var prog_val;
var s1_lbl;         // slider labels
var s2_lbl;
var cb1;            // tab 3
var cb2;
var cb3;
var r1;
var r2;
var chk_lbl;
var color_btn;      // 25 globals

// ── Tab Switching ──

fn switch_tab(idx) {
    critical();
    target(panel1); set(visible, 0); dirty();
    target(panel2); set(visible, 0); dirty();
    target(panel3); set(visible, 0); dirty();
    target(panel4); set(visible, 0); dirty();
    target(tab1); set(bg_color, 0x2945); dirty();
    target(tab2); set(bg_color, 0x2945); dirty();
    target(tab3); set(bg_color, 0x2945); dirty();
    target(tab4); set(bg_color, 0x2945); dirty();

    if (idx == 0) { target(panel1); set(visible, 1); dirty(); target(tab1); }
    if (idx == 1) { target(panel2); set(visible, 1); dirty(); target(tab2); }
    if (idx == 2) { target(panel3); set(visible, 1); dirty(); target(tab3); }
    if (idx == 3) { target(panel4); set(visible, 1); dirty(); target(tab4); }
    set(bg_color, 0x2C9F); dirty();
    active_tab = idx;
    render();
}

fn on_tab(wid) {
    if (wid == tab1) { switch_tab(0); }
    if (wid == tab2) { switch_tab(1); }
    if (wid == tab3) { switch_tab(2); }
    if (wid == tab4) { switch_tab(3); }
}

// ── Tab 1: Button callbacks ──

fn on_count(wid) {
    counter = counter + 1;
    target(counter_lbl);
    var s = itos(counter);
    var t = concat(str("Tapped: "), s);
    set(text, t);
    dirty();
    render();
    strClear();
}

fn on_reset(wid) {
    counter = 0;
    target(counter_lbl);
    set(text, "Tapped: 0");
    dirty();
    target(status_lbl);
    set(text, "Counter reset!");
    set(text_color, 0xFD20);
    dirty();
    render();
}

fn on_color(wid) {
    target(color_btn);
    var c = get(bg_color);
    if (c == 0xF800) { set(bg_color, 0x07E0); }
    else if (c == 0x07E0) { set(bg_color, 0x2C9F); }
    else { set(bg_color, 0xF800); }
    dirty();
    render();
}

// ── Tab 2: Slider callbacks ──

fn on_s1(wid, val) {
    target(s1_lbl);
    var s = itos(val);
    var t = concat(str("Brightness: "), concat(s, str("%")));
    set(text, t); dirty(); render();
    strClear();
    setBrightness(val);
}

fn on_s2(wid, val) {
    target(s2_lbl);
    var s = itos(val);
    var t = concat(str("Volume: "), concat(s, str("%")));
    set(text, t); dirty(); render();
    strClear();
}

// ── Tab 3: Check/Radio callbacks ──

fn on_check(wid) {
    target(cb1); var c1 = get(checked);
    target(cb2); var c2 = get(checked);
    target(cb3); var c3 = get(checked);
    var m = str("");
    if (c1) { m = concat(m, str("WiFi ")); }
    if (c2) { m = concat(m, str("BT ")); }
    if (c3) { m = concat(m, str("Sound ")); }
    if (!c1 && !c2 && !c3) { m = str("None"); }
    target(chk_lbl); set(text, m); dirty(); render();
    strClear();
}

fn on_radio(wid) {
    target(r1); var v1 = get(checked);
    target(r2); var v2 = get(checked);
    var m = str("Theme: ");
    if (v1) { m = concat(m, str("Light")); }
    if (v2) { m = concat(m, str("Dark")); }
    if (!v1 && !v2) { m = concat(m, str("Auto")); }
    target(chk_lbl); set(text, m); dirty(); render();
    strClear();
}

// ── Tab 4: Canvas paint ──

fn on_paint(wid) {
    var y = 90;

    // Filled rects
    fillRect(30, y, 70, 50, 0xF800);
    fillRect(110, y, 70, 50, 0x07E0);
    fillRect(190, y, 70, 50, 0x001F);
    fillRect(270, y, 70, 50, 0xFFE0);

    // Outlined rects
    rect(30, y + 65, 70, 50, 0xFFFF);
    rect(110, y + 65, 70, 50, 0x07FF);
    rect(190, y + 65, 70, 50, 0xF81F);
    rect(270, y + 65, 70, 50, 0xFD20);

    // Circles
    fillCircle(400, y + 25, 22, 0xFD20);
    circle(400, y + 25, 25, 0xFFFF);
    fillCircle(460, y + 25, 22, 0xFC18);
    circle(460, y + 25, 25, 0xFFFF);
    fillCircle(520, y + 25, 22, 0x867D);
    circle(520, y + 25, 25, 0xFFFF);

    // Star pattern with lines
    var cx = 460;
    var cy = y + 95;
    line(cx - 35, cy, cx + 35, cy, 0xFFE0);
    line(cx, cy - 35, cx, cy + 35, 0xFFE0);
    line(cx - 25, cy - 25, cx + 25, cy + 25, 0xFEA0);
    line(cx - 25, cy + 25, cx + 25, cy - 25, 0xFEA0);

    // Rounded rects
    fillRoundedRect(580, y, 190, 50, 10, 0x2945);
    drawText(600, y + 28, 0, 0xFFFF, 0x2945, "Rounded Fill");
    roundedRect(580, y + 65, 190, 50, 10, 0xB7E0);
    drawText(600, y + 95, 0, 0xB7E0, 0, "Rounded Line");

    // Color gradient
    var gx = 580;
    var gy = y + 140;
    fillRect(gx, gy, 38, 18, 0xF800);
    fillRect(gx + 38, gy, 38, 18, 0xFBE0);
    fillRect(gx + 76, gy, 38, 18, 0xFFE0);
    fillRect(gx + 114, gy, 38, 18, 0x07E0);
    fillRect(gx + 152, gy, 38, 18, 0x001F);

    // Arcs
    arc(120, y + 200, 40, 0, 90, 0xF800);
    arc(120, y + 200, 40, 90, 180, 0x07E0);
    arc(120, y + 200, 40, 180, 270, 0x001F);
    arc(120, y + 200, 40, 270, 360, 0xFFE0);
    arc(120, y + 200, 35, 0, 360, 0xFFFF);

    // Labels
    drawText(30, y + 270, 0, 0xFFFF, 0, "108MHz bare-metal rendering");
    drawText(30, y + 290, 0, 0x4208, 0, "rect, circle, line, arc, roundedRect, text");
}

