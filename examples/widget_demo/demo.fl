    set(clickable, 1); set(checked, 1); set(on_click, @on_radio);
    parent(b);
    l = alloc(); target(l); set(kind, 1);
    set(location, 40, 0); set(size, 200, 35);
    set(text_color, 0xFFFF); set(text, "Light Theme");
    parent(b);

    // Dark
    b = alloc(); target(b);
    set(location, 0, 45); set(size, 300, 35);
    parent(b);
    r2 = alloc(); target(r2);
    set(kind, 6); set(location, 0, 2); set(size, 28, 28);
    set(bg_color, 0x2104); set(text_color, 0xFFFF);
    set(press_color, 0x2C9F);
    set(clickable, 1); set(on_click, @on_radio);
    parent(b);
    l = alloc(); target(l); set(kind, 1);
    set(location, 40, 0); set(size, 200, 35);
    set(text_color, 0xFFFF); set(text, "Dark Theme");
    parent(b);

    // Auto
    b = alloc(); target(b);
    set(location, 0, 90); set(size, 300, 35);
    parent(b);
    l = alloc(); target(l);
    set(kind, 6); set(location, 0, 2); set(size, 28, 28);
    set(bg_color, 0x2104); set(text_color, 0xFFFF);
    set(press_color, 0x2C9F);
    set(clickable, 1); set(on_click, @on_radio);
    parent(b);
    l = alloc(); target(l); set(kind, 1);
    set(location, 40, 0); set(size, 200, 35);
    set(text_color, 0xFFFF); set(text, "Auto");
    parent(b);

    // Status label
    chk_lbl = alloc(); target(chk_lbl); set(kind, 1);
    set(location, 450, 50); set(size, 320, 28);
    set(text_color, 0x2C9F); set(text, "WiFi Sound");
    parent(panel3);

    // Right: large checkboxes
    l = alloc(); target(l); set(kind, 1);
    set(location, 450, 100); set(size, 300, 25);
    set(text_color, 0xC618); set(text, "Large Checkboxes");
    parent(panel3);

    b = alloc(); target(b);
    set(kind, 5); set(location, 450, 140); set(size, 45, 45);
    set(bg_color, 0x2104); set(text_color, 0x07E0);
    set(press_color, 0x07E0); set(border_radius, 6);
    set(clickable, 1); set(checked, 1);
    parent(panel3);
    l = alloc(); target(l); set(kind, 1);
    set(location, 505, 148); set(size, 150, 30);
    set(text_color, 0x07E0); set(text, "Accepted");
    parent(panel3);

    b = alloc(); target(b);
    set(kind, 5); set(location, 450, 200); set(size, 45, 45);
    set(bg_color, 0x2104); set(text_color, 0xF800);
    set(press_color, 0xF800); set(border_radius, 6);
    set(clickable, 1);
    parent(panel3);
    l = alloc(); target(l); set(kind, 1);
    set(location, 505, 208); set(size, 150, 30);
    set(text_color, 0xF800); set(text, "Rejected");
    parent(panel3);

    // Large radios
    l = alloc(); target(l); set(kind, 1);
    set(location, 450, 275); set(size, 300, 25);
    set(text_color, 0xC618); set(text, "Large Radio");
    parent(panel3);

    b = alloc(); target(b);
    set(location, 450, 310); set(size, 250, 40);
    parent(panel3);
    l = alloc(); target(l);
    set(kind, 6); set(size, 36, 36);
    set(bg_color, 0x2104); set(text_color, 0xF81F);
    set(press_color, 0xF81F); set(clickable, 1); set(checked, 1);
    parent(b);
    l = alloc(); target(l);
    set(kind, 6); set(location, 70, 0); set(size, 36, 36);
    set(bg_color, 0x2104); set(text_color, 0x07FF);
    set(press_color, 0x07FF); set(clickable, 1);
    parent(b);
    l = alloc(); target(l);
    set(kind, 6); set(location, 140, 0); set(size, 36, 36);
    set(bg_color, 0x2104); set(text_color, 0xFEA0);
    set(press_color, 0xFEA0); set(clickable, 1);
    parent(b);

    // ════════════════════════════════
    //  PANEL 4: CANVAS
    // ════════════════════════════════

    panel4 = alloc(); target(panel4);
    set(location, 0, 50); set(size, 800, 430); set(bg_color, 0x1082);
    set(visible, 0); set(on_paint, @on_paint);
    parent(0);

    l = alloc(); target(l); set(kind, 1);
    set(location, 20, 10); set(size, 760, 25);
    set(text_color, 0xC618);
    set(text, "Drawing Primitives (on_paint callback)");
    parent(panel4);

    // ── Done ──
    render();
    setBrightness(100);
    return 0;
}

fn loop() {
    // Animate progress bars on tab 2
    if (active_tab == 1) {
        prog_val = prog_val + 1;
        if (prog_val > 100) { prog_val = 0; }

        target(prog1); set(value, prog_val); dirty();

        var v2 = prog_val + 30;
        if (v2 > 100) { v2 = v2 - 100; }
        target(prog2); set(value, v2); dirty();

        target(prog3); set(value, 100 - prog_val); dirty();
        render();
    }
    delay(50);
}
