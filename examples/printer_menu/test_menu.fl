// test_menu.fl — Minimal menu test (3 buttons + sub-panel)

var C_BG = 0x1082;
var main_panel;
var sub_panel;
var btn_a;
var btn_b;
var btn_back;

fn on_main(widget_id) {
    if (widget_id == btn_a) {
        critical();
        target(main_panel);
        set(visible, 0);
        dirty();
        target(sub_panel);
        set(visible, 1);
        dirty();
        render();
    }
}

fn on_sub(widget_id) {
    if (widget_id == btn_back) {
        critical();
        target(sub_panel);
        set(visible, 0);
        dirty();
        target(main_panel);
        set(visible, 1);
        dirty();
        render();
    }
}

fn setup() {
    // Main panel
    main_panel = alloc();
    target(main_panel);
    set(size, 800, 480);
    set(bg_color, C_BG);
    parent(0);

    btn_a = alloc();
    target(btn_a);
    set(kind, 1);
    set(location, 100, 100);
    set(size, 250, 100);
    set(bg_color, 0x3186);
    set(press_color, 0x4A69);
    set(border, 2, 2, 2, 2);
    set(border_color, 0x5ACB);
    set(border_radius, 12);
    set(text_color, 0xFFFF);
    set(text_align, 1);
    set(text, "GO TO SUB");
    set(clickable, 1);
    set(on_click, 1);
    parent(main_panel);

    btn_b = alloc();
    target(btn_b);
    set(kind, 1);
    set(location, 450, 100);
    set(size, 250, 100);
    set(bg_color, 0x3186);
    set(press_color, 0x4A69);
    set(border, 2, 2, 2, 2);
    set(border_color, 0x5ACB);
    set(border_radius, 12);
    set(text_color, 0xFFFF);
    set(text_align, 1);
    set(text, "BUTTON B");
    set(clickable, 1);
    set(on_click, 1);
    parent(main_panel);

    // Sub panel (hidden)
    sub_panel = alloc();
    target(sub_panel);
    set(size, 800, 480);
    set(bg_color, 0x0010);
    set(visible, 0);
    parent(0);

    btn_back = alloc();
    target(btn_back);
    set(kind, 1);
    set(location, 250, 200);
    set(size, 300, 80);
    set(bg_color, 0xF800);
    set(press_color, 0x8000);
    set(border, 2, 2, 2, 2);
    set(border_color, 0xFFFF);
    set(border_radius, 12);
    set(text_color, 0xFFFF);
    set(text_align, 1);
    set(text, "< BACK");
    set(clickable, 1);
    set(on_click, 2);
    parent(sub_panel);

    render();
    return 0;
}

fn loop() {
    delay(50);
}
