// page_main.fl — Clock page: static UI widgets
//
// This runs during page load. The page widget (800x480) is already
// allocated by PageManager and set as VM target.
//
// Widget IDs (allocated in order):
//   Page widget = auto (PageManager)
//   0 = title label ("ferrite")
//   1 = time label (digital HH:MM:SS)

// --- Title label ---
var title = alloc();
target(title);
set(kind, 1);
set(location, 310, 260);
set(size, 180, 20);
set(bg_color, 0x2945);
set(text_color, 0x7BEF);
set(font_id, 0);
set(text_align, 1);
set(text, "ferrite");
parent(0);

// --- Digital time label ---
var timelbl = alloc();
target(timelbl);
set(kind, 1);
set(location, 250, 420);
set(size, 300, 50);
set(bg_color, 0x2945);
set(text_color, 0xFFFF);
set(font_id, 0);
set(text_align, 1);
set(border, 1, 1, 1, 1);
set(border_color, 0x4A69);
set(padding, 10, 10, 10, 10);
parent(0);

halt();
