// main.fl — Text Input Demo (800x480)
//
// Demonstrates KIND_INPUT widgets with on-screen keyboard.
// Two input fields (name + message) and a submit button.
// Typed text is echoed in a label below.

var title_lbl;
var name_lbl;
var name_input;
var msg_lbl;
var msg_input;
var submit_btn;
var submit_txt;
var output_lbl;
var divider;

fn rgb565(r, g, b) {
    return (r & 0xF8) * 256 + (g & 0xFC) * 8 + b / 8;
}

fn setup() {
    // ── Title ──
    title_lbl = alloc();
    target(title_lbl);
    set(kind, 1);
    set(location, 0, 10);
    set(size, 800, 40);
    set(text, "Text Input Demo");
    set(text_color, 0xFFFF);
    set(text_align, 1);
    set(font_id, 0);
    parent(0);

    // ── Divider line ──
    divider = alloc();
    target(divider);
    set(location, 50, 55);
    set(size, 700, 2);
    set(bg_color, 0x4208);
    parent(0);

    // ── Name field ──
    name_lbl = alloc();
    target(name_lbl);
    set(kind, 1);
    set(location, 50, 70);
    set(size, 100, 30);
    set(text, "Name:");
    set(text_color, rgb565(180, 180, 180));
    set(font_id, 0);
    parent(0);

    name_input = alloc();
    target(name_input);
    set(kind, 7);
    set(location, 160, 65);
    set(size, 540, 36);
    set(bg_color, rgb565(30, 30, 40));
    set(border, 1, 1, 1, 1);
    set(border_color, rgb565(80, 80, 120));
    set(border_radius, 4);
    set(padding, 6, 6, 6, 6);
    set(text_color, 0xFFFF);
    set(font_id, 0);
    set(max_length, 32);
    set(clickable, 1);
    set(on_change, @on_name_changed);
    parent(0);

    // ── Message field ──
    msg_lbl = alloc();
    target(msg_lbl);
    set(kind, 1);
    set(location, 50, 120);
    set(size, 100, 30);
    set(text, "Message:");
    set(text_color, rgb565(180, 180, 180));
    set(font_id, 0);
    parent(0);

    msg_input = alloc();
    target(msg_input);
    set(kind, 7);
    set(location, 160, 115);
    set(size, 540, 36);
    set(bg_color, rgb565(30, 30, 40));
    set(border, 1, 1, 1, 1);
    set(border_color, rgb565(80, 80, 120));
    set(border_radius, 4);
    set(padding, 6, 6, 6, 6);
    set(text_color, 0xFFFF);
    set(font_id, 0);
    set(max_length, 64);
    set(clickable, 1);
    set(on_change, @on_msg_changed);
    parent(0);

    // ── Submit button ──
    submit_btn = alloc();
    target(submit_btn);
    set(location, 160, 170);
    set(size, 160, 40);
    set(bg_color, rgb565(0, 100, 200));
    set(press_color, rgb565(0, 70, 150));
    set(border_radius, 6);
    set(clickable, 1);
    set(on_click, @on_submit);
    parent(0);

    submit_txt = alloc();
    target(submit_txt);
    set(kind, 1);
    set(location, 0, 0);
    set(size, 160, 40);
    set(text, "Submit");
    set(text_color, 0xFFFF);
    set(text_align, 1);
    set(font_id, 0);
    parent(submit_btn);

    // ── Output area ──
    output_lbl = alloc();
    target(output_lbl);
    set(kind, 1);
    set(location, 50, 230);
    set(size, 700, 30);
    set(text, "Tap an input field to start typing...");
    set(text_color, rgb565(120, 200, 120));
    set(font_id, 0);
    parent(0);

    render();
    return 0;
}

fn loop() {
    // Touch events and keyboard handled by framework
}

fn on_name_changed(wid) {
    target(output_lbl);
    strClear();
    var s = str("Name: ");
    target(name_input);
    var t = get(text);
    var out = concat(s, t);
    target(output_lbl);
    set(text, out);
    dirty();
}

fn on_msg_changed(wid) {
    target(output_lbl);
    strClear();
    var s = str("Message: ");
    target(msg_input);
    var t = get(text);
    var out = concat(s, t);
    target(output_lbl);
    set(text, out);
    dirty();
}

fn on_submit(wid) {
    target(output_lbl);
    strClear();
    var s1 = str("Submitted! Name=");
    target(name_input);
    var n = get(text);
    var s2 = concat(s1, n);
    var s3 = str(", Msg=");
    var s4 = concat(s2, s3);
    target(msg_input);
    var m = get(text);
    var s5 = concat(s4, m);
    target(output_lbl);
    set(text, s5);
    dirty();
}
