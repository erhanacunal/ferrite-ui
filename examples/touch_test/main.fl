
var root = alloc();
target(root);
set(size, 800, 480);
set(bg_color, 0x0000);
dirty();

var panel = alloc();
target(panel);
set(location, 150, 100);
set(size, 500, 280);
set(bg_color, 0x001F);
set(border, 3, 3, 3, 3);
set(border_color, 0xFFFF);

parent(root);

// Btn1 ve Btn2
var btn1 = alloc();
target(btn1);
set(location, 20, 20);
set(size, 100, 60);
set(bg_color, 0xF800);
set(press_color, rgb565(0,0,255));
set(clickable, 1);
parent(panel);

var btn2 = alloc();
target(btn2);
set(location, 40, 40);
set(size, 100, 60);
set(bg_color, rgb565(0,255,0));
set(press_color, rgb565(0,0,255));
set(clickable, 1);
parent(panel);

render();

while(true) {

}

fn click() {

}

fn rgb565(r, g, b) {
    return (r & 0xF8) * 256 + (g & 0xFC) * 8 + b / 8;
}

