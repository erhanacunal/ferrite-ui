// gpio.fl — User GPIO header constants
// Usage: #include "gpio.fl"
//
//   pinMode(pin, mode)    — configure a pin (mode: GPIO_* below)
//   pinWrite(pin, value)  — drive an output pin; non-zero = high
//   pinRead(pin)          — pin level, 0 or 1 (outputs read what they drive)
//
// Pins are numbered 0..7 on every board that has the header:
//
//   pin   GD32 Nextion   N32903
//   0     PC2            GPD3
//   1     PC3            GPD2
//   2     PC4            GPB2
//   3     PC5            GPB3
//   4     PC6            GPB4
//   5     PC7            GPB5
//   6     PC8            GPB6
//   7     PC9            GPA0
//
// LilyGo T5-ePaper-S3: pin 0 only = BUTTON_1 (GPIO21), input-only, pull-up on
// from boot, reads 0 while pressed.
//
// Pins stay floating inputs until pinMode is called. A pin number the board
// doesn't have, or a mode it can't do (N32903 has no pull-downs), stops the
// program with VM fault 14.

const GPIO_INPUT          = 0;
const GPIO_OUTPUT         = 1;
const GPIO_INPUT_PULLUP   = 2;
const GPIO_INPUT_PULLDOWN = 3; // GD32 and T5

const GPIO_LOW  = 0;
const GPIO_HIGH = 1;
