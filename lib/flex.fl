// flex.fl — Flex layout (row / column) for widget containers
// Usage: #include "flex.fl"
//
// The layout data lives on the widgets themselves; the firmware only stores
// it, and flexLayout() below does the placement:
//
//   box.flex      = FLEX_ROW | JUSTIFY_CENTER | ITEMS_STRETCH;  // container mode
//   box.flex_gap  = 8;                                         // px between children
//   item.flex_grow = 1;                                        // child takes leftover space
//   flexLayout(box);
//
// flexLayout(box) places the visible children of `box` inside its content
// area (size minus border and padding), in tree order:
//   - main axis (x for FLEX_ROW, y for FLEX_COLUMN): children keep their size,
//     separated by flex_gap. Children with flex_grow share the leftover space
//     in proportion to it, and their own main size is ignored (like CSS
//     `flex: 1`), so calling flexLayout again gives the same result. Without
//     any grower, JUSTIFY_* decides where the children sit. JUSTIFY_STRETCH
//     gives every child a grow of 1 unless it has its own flex_grow (equal
//     sizes).
//   - cross axis: ITEMS_* aligns each child; ITEMS_STRETCH sets its cross
//     size to the full content size.
// It sets loc_x/loc_y/size_w/size_h of the children (marking them dirty) and
// then lays out children that are flex containers themselves. Call it again
// after changing sizes, visibility or children. Hidden children take no space.
// Growing / stretched sizes overwrite the child's size: set it again before
// switching a container away from JUSTIFY_STRETCH or ITEMS_STRETCH.
//
// The ITEMS_* names avoid core.fl's ALIGN_* (text alignment).
//
// FLEX_GRID: the visible children in rows of `grid_cols` cells (0 reads as 1),
// in tree order, left to right. The content width minus the gaps is split
// into equal columns (the first columns get the rounding rest); a row is as
// tall as its tallest child, and rows are flex_gap apart, as are columns.
// JUSTIFY_* places a child in its cell's width (JUSTIFY_STRETCH: the cell's
// width), ITEMS_* in its row's height (ITEMS_STRETCH: the row's height);
// flex_grow is ignored. A grid that clips its children (a scroll container)
// keeps GRID_SCROLLBAR_W px on the right for the scrollbar. Rows can go past
// the box: in a scroll container they scroll (GridView below).
//
//   var g = GridView(size: [600, 400], grid_cols: 4, flex_gap: 8);
//   Button(text: "A", size: [0, 80], parent: g);   // width set by the grid
//
// FLEX_AUTO (ferrite-ui-xl, boards with caps.native_flex): the firmware lays
// the container out by itself whenever its box, a child's size / visibility /
// flex_grow or its children change, before the next render and before a
// position or size is read, so flexLayout() is not needed. Elsewhere the bit
// is ignored: call flexLayout() as usual (code that does works on both).
//   box.flex = FLEX_ROW | ITEMS_CENTER | FLEX_AUTO;

// Direction (bits 0-1). 0 = not a flex container.
const FLEX_ROW    = 1;
const FLEX_COLUMN = 2;
const FLEX_GRID   = 3;

// Main-axis justify (bits 2-4)
const JUSTIFY_START         = 0;
const JUSTIFY_CENTER        = 4;
const JUSTIFY_END           = 8;
const JUSTIFY_SPACE_BETWEEN = 12;
const JUSTIFY_STRETCH       = 16;

// Cross-axis align (bits 5-6)
const ITEMS_START   = 0;
const ITEMS_CENTER  = 32;
const ITEMS_END     = 64;
const ITEMS_STRETCH = 96;

// Automatic layout (bit 7; see above)
const FLEX_AUTO = 128;

// Room a scrolling FLEX_GRID keeps for the scrollbar (render.rs SCROLLBAR_W).
const GRID_SCROLLBAR_W = 10;

// Flex containers as widget constructors (lib/core.fl). A `flex:` argument
// replaces the default, so it names the direction too:
//   Column(flex: FLEX_COLUMN | ITEMS_STRETCH, children: [...])
widget Row(flex: FLEX_ROW);
widget Column(flex: FLEX_COLUMN);
// A scrolling grid: drag / fling and the scrollbar come with clip_children.
// Without caps.native_flex (no FLEX_AUTO) call flexLayout(g) after adding
// the cells.
widget GridView(flex: FLEX_GRID | JUSTIFY_STRETCH | FLEX_AUTO, grid_cols: 3,
                clip_children: 1);

fn flexLayout(box: widget) {
    // Lays out `box`, then the flex containers below it in tree order: a
    // child's size is final once its parent is laid out. A walk over the tree
    // (first_child / next_sibling / parent), as .fl has no recursion. The
    // target is left where the recursive version left it.
    if (flexPlace(box) == 0) {
        return;
    }
    var cur: widget = box;
    var placed = 1;
    while (true) {
        var nxt: widget = -1;
        if (placed) {
            target(cur);
            nxt = flexNextBox(get(first_child));
        }
        while (nxt < 0) {
            if (cur == box) {
                target(box);
                return;
            }
            target(cur);
            nxt = flexNextBox(get(next_sibling));
            if (nxt < 0) {
                target(cur);
                cur = get(parent);
            }
        }
        cur = nxt;
        placed = flexPlace(cur);
    }
}

// `c` or the first sibling after it that is a visible flex container; -1 if
// none.
fn flexNextBox(c: widget) -> int {
    while (c >= 0) {
        target(c);
        if (get(visible) && (get(flex) & 3)) {
            return c;
        }
        c = get(next_sibling);
    }
    return -1;
}

// Places the visible children of `box` (flexLayout without the nested
// containers). 1 if it placed any, 0 if `box` is no flex container or has
// no visible child.
fn flexPlace(box: widget) -> int {
    target(box);
    var mode = get(flex);
    var dir = mode & 3;
    if (dir == 0) {
        return 0;
    }
    var justify = mode & 28;
    var items = mode & 96;
    var gap = get(flex_gap);

    // Content area size.
    var cw = get(size_w) - get(border_left) - get(border_right)
             - get(padding_left) - get(padding_right);
    var ch = get(size_h) - get(border_top) - get(border_bottom)
             - get(padding_top) - get(padding_bottom);
    if (dir == FLEX_GRID) {
        return gridPlace(box, cw, gap, justify, items);
    }
    var main_len = cw;
    var cross_len = ch;
    if (dir == FLEX_COLUMN) {
        main_len = ch;
        cross_len = cw;
    }

    // Pass 1: count visible children, sum their main sizes and grow factors.
    var count = 0;
    var used = 0;
    var grow_total = 0;
    var g;
    var c: widget = get(first_child);
    while (c >= 0) {
        target(c);
        if (get(visible)) {
            count++;
            g = get(flex_grow);
            if (g == 0 && justify == JUSTIFY_STRETCH) {
                g = 1;
            }
            if (g == 0) {
                used += dir == FLEX_ROW ? get(size_w) : get(size_h);
            }
            grow_total += g;
        }
        c = get(next_sibling);
    }
    if (count == 0) {
        return 0;
    }

    var free = main_len - used - gap * (count - 1);
    var pos = 0;
    var extra_gap = 0;     // JUSTIFY_SPACE_BETWEEN: added to every gap
    var extra_rem = 0;     // ...plus 1 px for the first extra_rem gaps
    if (grow_total == 0 && free > 0) {
        if (justify == JUSTIFY_CENTER) {
            pos = free / 2;
        } else if (justify == JUSTIFY_END) {
            pos = free;
        } else if (justify == JUSTIFY_SPACE_BETWEEN && count > 1) {
            extra_gap = free / (count - 1);
            extra_rem = free % (count - 1);
        }
    }
    var free_left = free > 0 ? free : 0;   // grow space not handed out yet
    var grow_left = grow_total;

    // Pass 2: place the children.
    target(box);
    c = get(first_child);
    while (c >= 0) {
        target(c);
        if (get(visible)) {
            var size = dir == FLEX_ROW ? get(size_w) : get(size_h);
            g = get(flex_grow);
            if (g == 0 && justify == JUSTIFY_STRETCH) {
                g = 1;
            }
            if (g > 0) {
                // Proportional share; the last grower gets the rounding rest.
                size = free_left * g / grow_left;
                free_left -= size;
                grow_left -= g;
            }

            var csize = dir == FLEX_ROW ? get(size_h) : get(size_w);
            var cpos = 0;
            if (items == ITEMS_CENTER) {
                cpos = (cross_len - csize) / 2;
            } else if (items == ITEMS_END) {
                cpos = cross_len - csize;
            } else if (items == ITEMS_STRETCH) {
                csize = cross_len;
            }

            if (dir == FLEX_ROW) {
                set(loc_x, pos);
                set(loc_y, cpos);
                set(size_w, size);
                set(size_h, csize);
            } else {
                set(loc_x, cpos);
                set(loc_y, pos);
                set(size_w, csize);
                set(size_h, size);
            }

            pos += size + gap + extra_gap;
            if (extra_rem > 0) {
                pos++;
                extra_rem--;
            }
        }
        c = get(next_sibling);
    }

    // Children moved: repaint the container so their old spots are cleared.
    target(box);
    dirty();
    return 1;
}

// flexPlace for FLEX_GRID: `cw` = the content width; the target is `box`.
fn gridPlace(box: widget, cw, gap, justify, items) -> int {
    if (get(clip_children)) {
        cw -= GRID_SCROLLBAR_W;
    }
    var grid_n = get(grid_cols);
    if (grid_n < 1) {
        grid_n = 1;
    }
    var grid_avail = cw - gap * (grid_n - 1);   // the columns' widths together
    if (grid_avail < 0) {
        grid_avail = 0;
    }
    var grid_placed = 0;
    var grid_col = 0;
    var grid_y = 0;
    var grid_row_h = 0;
    var c: widget = get(first_child);
    while (c >= 0) {
        target(c);
        if (get(visible)) {
            if (grid_col == 0) {
                // Row height: the tallest of the row's children.
                grid_row_h = 0;
                var grid_scan: widget = c;
                var grid_seen = 0;
                while (grid_scan >= 0 && grid_seen < grid_n) {
                    target(grid_scan);
                    if (get(visible)) {
                        if (get(size_h) > grid_row_h) {
                            grid_row_h = get(size_h);
                        }
                        grid_seen++;
                    }
                    grid_scan = get(next_sibling);
                }
                target(c);
            }
            var grid_cell_x = grid_avail * grid_col / grid_n;
            var grid_cell_w = grid_avail * (grid_col + 1) / grid_n - grid_cell_x;
            grid_cell_x += gap * grid_col;
            var grid_item_w = get(size_w);
            var grid_item_h = get(size_h);
            var grid_item_x = grid_cell_x;
            var grid_item_y = grid_y;
            if (justify == JUSTIFY_STRETCH) {
                grid_item_w = grid_cell_w;
            } else if (justify == JUSTIFY_CENTER) {
                grid_item_x = grid_cell_x + (grid_cell_w - grid_item_w) / 2;
            } else if (justify == JUSTIFY_END) {
                grid_item_x = grid_cell_x + grid_cell_w - grid_item_w;
            }
            if (items == ITEMS_STRETCH) {
                grid_item_h = grid_row_h;
            } else if (items == ITEMS_CENTER) {
                grid_item_y = grid_y + (grid_row_h - grid_item_h) / 2;
            } else if (items == ITEMS_END) {
                grid_item_y = grid_y + grid_row_h - grid_item_h;
            }
            set(loc_x, grid_item_x);
            set(loc_y, grid_item_y);
            set(size_w, grid_item_w);
            set(size_h, grid_item_h);
            grid_placed = 1;
            grid_col++;
            if (grid_col == grid_n) {
                grid_col = 0;
                grid_y += grid_row_h + gap;
            }
        }
        c = get(next_sibling);
    }
    // Children moved: repaint the container so their old spots are cleared.
    target(box);
    dirty();
    return grid_placed;
}
