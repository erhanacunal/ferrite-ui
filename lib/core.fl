// core.fl — Widget system constants
// Usage: #include "core.fl"

// Widget kinds
const KIND_BASE     = 0;
const KIND_LABEL    = 1;
const KIND_BUTTON   = 2;
const KIND_PROGRESS = 3;
const KIND_SLIDER   = 4;
const KIND_CHECKBOX = 5;
const KIND_RADIO    = 6;
const KIND_INPUT    = 7;
const KIND_GAUGE    = 8;
const KIND_DROPDOWN = 9;
const KIND_GRAPH    = 10;
const KIND_IMAGE    = 11;
// 12-16: shape widgets (lib/shapes.fl)
const KIND_BUTTON_GROUP = 17;  // exclusive toggle button: one selected per group_id
const KIND_MODEL3D  = 18;  // 3D model view (exynos4412 GPU, lib/model3d.fl)

// Text alignment
const ALIGN_LEFT   = 0;
const ALIGN_CENTER = 1;
const ALIGN_RIGHT  = 2;

// Boolean values for set() calls
const ON  = 1;
const OFF = 0;

// Widget constructors: `var b = Button(text: "OK", size: [120, 40]);`
// Arguments are property names; the call's own arguments override these
// defaults. `children: [...]` and `parent: w` build the tree (see
// docs/ferrite-lang.md "Widget constructors").
widget Box();
widget Label(kind: KIND_LABEL);
widget Button(kind: KIND_BUTTON);
widget Progress(kind: KIND_PROGRESS);
widget Slider(kind: KIND_SLIDER);
widget Checkbox(kind: KIND_CHECKBOX);
widget Radio(kind: KIND_RADIO);
widget Input(kind: KIND_INPUT);
widget Gauge(kind: KIND_GAUGE);
widget Dropdown(kind: KIND_DROPDOWN);
widget Graph(kind: KIND_GRAPH);
widget Image(kind: KIND_IMAGE);
widget ButtonGroup(kind: KIND_BUTTON_GROUP);
