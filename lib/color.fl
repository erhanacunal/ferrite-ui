// color.fl — RGB565 color constants
// Usage: #include "color.fl"

// Basic colors
const BLACK   = 0x0000;
const WHITE   = 0xFFFF;
const RED     = 0xF800;
const GREEN   = 0x07E0;
const BLUE    = 0x001F;
const YELLOW  = 0xFFE0;
const CYAN    = 0x07FF;
const MAGENTA = 0xF81F;

// Grays
const DARK_GRAY  = 0x4208;
const GRAY       = 0x8410;
const LIGHT_GRAY = 0xC618;

// Extended colors
const ORANGE     = 0xFD20;
const PINK       = 0xFC18;
const PURPLE     = 0x8010;
const BROWN      = 0x8200;
const NAVY       = 0x0010;
const DARK_GREEN = 0x0320;
const DARK_RED   = 0x8000;
const OLIVE      = 0x8400;
const TEAL       = 0x0410;
const SKY_BLUE   = 0x867D;
const LIME       = 0xB7E0;
const GOLD       = 0xFEA0;
