// apps.fl — installed app packages (ferrite-ui-xl docs/apps.md): list them and
// run one, e.g. from a launcher in the system image.
//
// An app is a project built with "application_id" in its project.json and
// installed with `ferrite_cli app install` (ferrite/apps/{id}/ on the board).
// It runs in place of the system image: its own programs and resources, its own
// files (disk*) and EEPROM, none of another app's. runApp("") goes back to the
// system image.
//
// Ids are duplicated in ferrite-ui-xl ferrite-core/src/apps.rs (SYS_APP_*) —
// keep them in sync. On boards without app storage appCount() is 0.

const SYS_APP_COUNT   = 0x80;  // () -> number of installed apps
const SYS_APP_ID      = 0x81;  // (i) -> string: app i's id (sorted by id), "" past the end
const SYS_APP_NAME    = 0x82;  // (i) -> string: app i's display name, "" past the end
const SYS_APP_RUN     = 0x83;  // (id: str_id) -> ends every program and runs the app; 0 if not installed
const SYS_APP_CURRENT = 0x84;  // () -> string: the running app's id, "" for the system image

fn appCount() { return syscall(SYS_APP_COUNT); }
fn appId(i) -> string { return syscallStr(SYS_APP_ID, i); }
fn appName(i) -> string { return syscallStr(SYS_APP_NAME, i); }
fn currentApp() -> string { return syscallStr(SYS_APP_CURRENT); }

// Runs installed app `id` ("" = the system image) from the next frame, like
// runProgram: nothing of the caller runs after it. Returns 0 (and the caller
// goes on) if `id` is not installed.
fn runApp(id: string) { return syscall(SYS_APP_RUN, id); }
